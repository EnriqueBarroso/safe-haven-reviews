# URL base del servidor local
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Cuenta de prueba ya existente en Supabase (email + contraseña)
# Crea este usuario una vez manualmente en /auth/register
TEST_USER_EMAIL=test@yafui.dev
TEST_USER_PASSWORD=TestPassword123!

# Slug de un perfil con al menos una reseña pública
# Usado por los tests de respuesta y dashboard
# Ejemplo: si el perfil está en /profiles/luna-barcelona → TEST_PROFILE_SLUG=luna-barcelona
TEST_PROFILE_SLUG=luna-barcelona

# (Opcional) Service Role Key de Supabase — permite borrar perfiles de prueba tras cada ejecución
# Supabase dashboard → Settings → API → service_role key
# SIN esta key, solo se borran reseñas/preguntas; los perfiles huérfanos requieren SQL manual
TEST_SUPABASE_SERVICE_ROLE_KEY=
